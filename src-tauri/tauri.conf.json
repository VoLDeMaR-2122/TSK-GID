{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ГИД Урал-ВНИИЖТ",
  "version": "0.1.0",
  "identifier": "com.tsv.gid-ural",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "https://gid.tsk-community.online"
  },
  "app": {
    "windows": [
      {
        "title": "ГИД-TSK Урал-ВНИИЖТ",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
