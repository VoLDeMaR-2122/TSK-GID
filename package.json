{
  "name": "gid-ural",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server.ts --outfile=dist/server.cjs --platform=node --format=cjs --target=node20",
    "start": "node dist/server.cjs",
    "lint": "eslint .",
    "backend:dev": "cargo run --manifest-path backend/Cargo.toml",
    "backend:build": "cargo build --release --manifest-path backend/Cargo.toml",
    "backend:check": "cargo clippy --manifest-path backend/Cargo.toml --all-targets",
    "backend:test": "node backend/protocol-check.mjs",
    "backend:test:auth": "node backend/auth-check.mjs",
    "dev:rust": "concurrently -n next,rust -c cyan,magenta \"next dev -p 3000\" \"cargo run --manifest-path backend/Cargo.toml\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pg": "^8.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.5.13",
    "concurrently": "^10.0.5",
    "esbuild": "^0.24.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260901.1": true,
    "esbuild@0.28.2": true
  }
}
